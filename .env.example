# =============================================================================
# Quant Research Engine — Environment Variables
# =============================================================================
#
# Setup:
#   cp .env.example .env
#   # edit .env with your database credentials
#   set -a && source .env && set +a
#
# =============================================================================
# === REQUIRED ===
# =============================================================================

# Market database URL — daily OHLCV bars (public.stock_daily)
# Format: postgresql+psycopg://user:pass@host:port/database
QRE_MARKET_DB_URL=postgresql+psycopg://user:pass@localhost:5432/tushare_data

# =============================================================================
# === OPTIONAL — fall back to QRE_MARKET_DB_URL if unset ===
# =============================================================================

# Factor database — technical indicator columns in factors.*
# QRE_FACTOR_DB_URL=postgresql+psycopg://user:pass@localhost:5432/tushare_data

# Reference database — metadata tables in reference.*
# QRE_REFERENCE_DB_URL=postgresql+psycopg://user:pass@localhost:5432/tushare_data

# Benchmark database — index/benchmark data
# QRE_BENCHMARK_DB_URL=postgresql+psycopg://user:pass@localhost:5432/tushare_data

# Research database
# QRE_RESEARCH_DB_URL=postgresql+psycopg://user:pass@localhost:5432/tushare_data

# =============================================================================
# === TABLE OVERRIDES (optional — defaults shown) ===
# =============================================================================

# QRE_MARKET_DAILY_TABLE=public.stock_daily
# QRE_SECURITY_METADATA_TABLE=
# QRE_TRADE_CALENDAR_TABLE=
# QRE_BENCHMARK_DAILY_TABLE=

# =============================================================================
# === LEGACY FALLBACKS (compatible with strategy-research naming) ===
# =============================================================================
#
# If QRE_* vars are unset, the engine also checks:
#   SR_MARKET_DB_URL       →  QRE_MARKET_DB_URL
#   SR_FACTOR_DB_URL       →  QRE_FACTOR_DB_URL
#   SR_REFERENCE_DB_URL    →  QRE_REFERENCE_DB_URL
#   SR_BENCHMARK_DB_URL    →  QRE_BENCHMARK_DB_URL
#   SR_RESEARCH_DB_URL     →  QRE_RESEARCH_DB_URL
#   SR_MARKET_DAILY_TABLE  →  QRE_MARKET_DAILY_TABLE
#   SR_SECURITY_METADATA_TABLE → QRE_SECURITY_METADATA_TABLE
#   SR_TRADE_CALENDAR_TABLE → QRE_TRADE_CALENDAR_TABLE
#   SR_BENCHMARK_DAILY_TABLE  → QRE_BENCHMARK_DAILY_TABLE
