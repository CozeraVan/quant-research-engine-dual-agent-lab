# QRE 一键上云配置（买云后复制为 deploy/cloud/cloud.env 并填真实值）
# 本文件只放**非机密或连接占位**；真实密码请填在 cloud.env（该文件已 gitignore，不要提交）。

# ---------- 源端（家里 WSL，只读） ----------
SOURCE_DB_URL="postgresql://user:password@127.0.0.1:5432/tushare_data"
LOCAL_BACKUP_DIR="/home/van/backups/cloud-migration"

# ---------- 云数据库（与 worker 同 VPC，私网） ----------
CLOUD_DB_URL="postgresql://qre_readonly:password@10.0.0.10:5432/tushare_data"
CLOUD_DB_SSH="ubuntu@10.0.0.10"                 # 用于 pg_restore 与参数设置
CLOUD_DB_SSH_KEY="$HOME/.ssh/cloud_db_ed25519"

# ---------- 云 worker（可多台，空格分隔） ----------
CLOUD_WORKER_SSH_LIST="ubuntu@10.0.0.11 ubuntu@10.0.0.12"
CLOUD_WORKER_SSH_KEY="$HOME/.ssh/cloud_worker_ed25519"
CLOUD_WORKER_COUNT=2                            # 与上面主机数一致，便于校验

# ---------- SaaS / worker 协议 ----------
QRE_SAAS_BASE_URL="https://www.aguhuice.com"
QRE_WORKER_TOKEN="replace-with-real-worker-token"
QRE_WORKER_ID="cloud-worker-1"

# ---------- 对象存储（产物） ----------
# 例：s3://qre-artifacts/prod 或 oss://qre-artifacts/prod（脚本按 aws/rclone 自动选择）
ARTIFACT_DST="s3://qre-artifacts/prod"

# ---------- 可选项 ----------
MIGRATE_JOBS=4
VERIFY_TABLES="public.stock_daily:trade_date,public.stock_minute_1m:trade_time,factors.stock_daily_overlap_close:trade_date,factors.stock_daily_momentum_close:trade_date,factors.stock_daily_alpha191:trade_date,reference.stock_basic:"
ALLOW_NONEMPTY=0                                 # 目标库非空时是否允许恢复（默认拒绝，防误写）
SKIP_SMOKE=0                                     # 部署后是否跳过 smoke 检查
