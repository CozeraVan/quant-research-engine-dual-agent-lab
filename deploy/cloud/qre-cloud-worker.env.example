# QRE cloud worker env template. Copy to /etc/qre-cloud-worker.env and fill values.
# NEVER commit the filled env file.

# SaaS / queue
QRE_SAAS_BASE_URL=https://aguhuice.com
QRE_WORKER_TOKEN=__FILL_ME__
QRE_WORKER_ID=cloud-worker-01

# Cloud market DB (private VPC endpoint, read-only role recommended)
QRE_MARKET_DB_URL=postgresql://qre_worker_ro:__FILL_ME__@__CLOUD_DB_PRIVATE_ENDPOINT__:5432/tushare_data

# Factor/reference DBs if split in cloud; otherwise leave empty to reuse market URL
QRE_FACTOR_DB_URL=
QRE_REFERENCE_DB_URL=
QRE_BENCHMARK_DB_URL=

# Result upload
QRE_WORKER_UPLOAD_FILES=1
# Object storage for large artifacts (future); empty means current SaaS upload path
QRE_ARTIFACT_S3_BUCKET=
QRE_ARTIFACT_S3_PREFIX=artifacts

# Scheduling / resource gates (same semantics as home worker)
QRE_WORKER_LIGHT_SLOTS=2
QRE_WORKER_HEAVY_SLOTS=3
QRE_WORKER_LIGHT_MIN_AVAIL_MB=2000
QRE_WORKER_HEAVY_MIN_AVAIL_MB=6500
QRE_WORKER_STATUS_SECONDS=15
QRE_WORKER_CHILD_MEM_GB=14

# Proxy: cloud worker should NOT need proxy. If your environment requires one, set explicitly.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
