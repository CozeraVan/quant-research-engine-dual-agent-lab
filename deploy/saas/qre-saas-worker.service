# QRE SaaS staging Worker（本机轮询 8081 的任务队列，QRE-SAAS-008）。
#
# 8081 = SaaS staging（预发）：本 Worker 从 http://127.0.0.1:8081 领任务、
# 本地只读大库跑回测、结果回传 8081。生产 Worker 模板见同目录
# qre-worker.service（指向 https://aguhuice.com）。
#
# 安装（需 sudo，与 qre-gui-lab 同级系统服务）：
#   sudo cp deploy/saas/qre-saas-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qre-saas-worker.service
#   journalctl -u qre-saas-worker -f
#
# SAAS_WORKER_TOKEN 必须与 .env.saas-staging 中一致（EnvironmentFile 同一文件）。

[Unit]
Description=QRE SaaS staging worker (polls 127.0.0.1:8081 job queue)
After=network-online.target postgresql.service qre-gui-lab.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=van
WorkingDirectory=/home/van/quant-workspace/quant-research-engine-dual-agent-lab
EnvironmentFile=/home/van/quant-workspace/quant-research-engine-dual-agent-lab/.env.saas-staging
Environment=SAAS_CLOUD_URL=http://127.0.0.1:8081
Environment=SAAS_WORKER_ID=wsl-staging
Environment=SAAS_WORKER_POLL_SECONDS=5
Environment=QRE_MARKET_DB_URL=postgresql+psycopg://qre_worker_ro:qre_ro_local_only_2026@127.0.0.1/tushare_data
ExecStart=/home/van/.local/bin/uv run qre worker
Restart=always
RestartSec=10
# 优雅退出：SIGTERM 后等手头任务完成回传（回测多为分钟级），超时强杀
TimeoutStopSec=900
MemoryMax=4G
Nice=10
SyslogIdentifier=qre-saas-worker

[Install]
WantedBy=multi-user.target
