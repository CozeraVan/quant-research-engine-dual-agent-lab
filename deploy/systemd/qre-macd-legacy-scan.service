[Unit]
Description=QRE MACD legacy column-name weekly scan (TV R4-4 / R5-2)
Documentation=file:/home/van/quant-workspace/quant-research-engine-dual-agent-lab/docs/agent/20_DATA_DICTIONARY_DAILY_MINUTE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=van
WorkingDirectory=/home/van/quant-workspace/quant-research-engine-dual-agent-lab
Environment=LEGACY_RETENTION_DAYS=15
ExecStart=/home/van/quant-workspace/quant-research-engine-dual-agent-lab/deploy/saas/scan-macd-legacy-names.sh --record
# R6-1：stdout 走 journal（不再落 .tmp——运行痕迹也不该活在 scratch 里），
# 与脚本内 `--record` 写入的仓库内证据日志形成双保险。
StandardOutput=journal
StandardError=journal
